# HTTP Basic Auth, gating the whole site while this is a staging domain.
# The .htpasswd itself is generated/managed via Plesk's "Password-protected
# Directories" GUI (no SSH needed to run htpasswd), not committed to git -
# only this reference to its path is. Kept here (rather than left to Plesk's
# own auto-injected .htaccess block) because this file is git-deployed on
# every push and would otherwise wipe Plesk's injected auth on the next
# deploy.
AuthType Basic
AuthName "Restricted"
AuthUserFile /var/www/vhosts/kneipenkonzerte.de/static.ollis-weihnachtsgeschichten.de/public/.htpasswd
Require valid-user

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Serve the pre-rendered static export directly, bypassing PHP/DB
    # entirely, whenever a matching file exists - this is what makes the
    # site "static" for visitors while Laravel/Filament stay the CMS.
    # Admin/Livewire/asset routes never have a cache file, so they fall
    # through to the normal front-controller rules below untouched.
    RewriteCond %{REQUEST_METHOD} GET
    RewriteCond %{DOCUMENT_ROOT}/cache%{REQUEST_URI}index.html -f
    RewriteRule ^ /cache%{REQUEST_URI}index.html [L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
